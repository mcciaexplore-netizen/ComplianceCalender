{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/build-vercel-proxy.mjs",
  "outputDirectory": ".vercel-public",
  "routes": [
    {
      "src": "^/(.*)$",
      "dest": "https://compliance-mitra.vedshridikkar.chatgpt.site/$1",
      "respectOriginCacheControl": false,
      "headers": {
        "x-vercel-enable-rewrite-caching": "0",
        "Cache-Control": "private, no-store"
      }
    }
  ]
}
