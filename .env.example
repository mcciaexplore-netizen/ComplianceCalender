# Server-side settings only. Never prefix secrets with NEXT_PUBLIC_ or VITE_.
# Copy this file to .dev.vars for local use with this Cloudflare-compatible app.
# All credentials can stay empty for the isolated demo.
DATABASE_URL=
VECTOR_DATABASE_URL=
USE_PGVECTOR=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
STT_API_KEY=
STT_PROVIDER=deepgram
AUTH_SECRET=
WEBSOCKET_URL=
